+        modules = component.get("modules")
+        if (
+            not isinstance(modules, dict)
+            or bool(modules) != component["enabled"]
+        ):
+            raise ValueError(f"invalid ModelOpt calibration for {name!r}")
+        for path, calibration in modules.items():
